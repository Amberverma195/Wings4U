{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "MOBILE_APP_ENV": "production",
        "EXPO_PUBLIC_API_ORIGIN": "https://api.wings4ulondon.ca"
      }
    },
    "production": {
      "env": {
        "MOBILE_APP_ENV": "production",
        "EXPO_PUBLIC_API_ORIGIN": "https://api.wings4ulondon.ca"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
